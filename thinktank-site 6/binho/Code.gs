const SHEET_ID='1ahIvP5qEmEyDyWe9o2ynbZ4s6Qg1hTvCexzu8TCK5QY';
function doGet(e){const ss=SpreadsheetApp.openById(SHEET_ID);const p=ss.getSheetByName('Players').getDataRange().getValues().slice(1).filter(r=>r[1]).map(r=>r[1]);const schedule=ss.getSheetByName('Schedule').getDataRange().getValues().slice(1).filter(r=>r[0]).map(r=>({id:r[0],week:r[1],p1:r[2],p2:r[3],s1:r[4],s2:r[5],status:r[6]}));const playoffs=ss.getSheetByName('Playoffs').getRange(2,1,19,8).getValues().map(r=>({id:r[0],bracket:r[1],round:r[2],ref1:r[3],ref2:r[4],s1:r[5],s2:r[6]}));const output=JSON.stringify({players:p,schedule,playoffs});return ContentService.createTextOutput(output).setMimeType(ContentService.MimeType.JSON)}
function doPost(e){const props=PropertiesService.getScriptProperties();const secret=props.getProperty('ADMIN_TOKEN');const body=JSON.parse(e.postData.contents||'{}');if(!secret||body.token!==secret)throw Error('Unauthorized');if(!/^(W[1-9]-G[1-5]|P(?:[1-9]|1[0-9]))$/.test(body.id))throw Error('Invalid match');const a=Number(body.s1),b=Number(body.s2);if(!Number.isInteger(a)||!Number.isInteger(b)||a<0||b<0||a>100||b>100)throw Error('Invalid scores');const lock=LockService.getScriptLock();lock.waitLock(10000);try{const isPlayoff=body.id[0]==='P';const sheet=SpreadsheetApp.openById(SHEET_ID).getSheetByName(isPlayoff?'Playoffs':'Schedule');const rows=sheet.getRange(2,1,sheet.getLastRow()-1,1).getValues();const idx=rows.findIndex(r=>r[0]===body.id);if(idx<0)throw Error('Unknown match');sheet.getRange(idx+2,isPlayoff?6:5,1,2).setValues([[a,b]]);return ContentService.createTextOutput(JSON.stringify({ok:true})).setMimeType(ContentService.MimeType.JSON)}finally{lock.releaseLock()}}
